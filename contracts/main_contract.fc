;; =============================================================================
;; EXAMPLE 1: Race condition (ENLIST/owner) — User Fund Loss Due to Race Conditions
;; Reference: MeMeStore (TonBit) BCJ-4, Contract Examples.docx
;; Audit: https://tonbit.xyz/reports/20240708-MeMeStore-Final-Audit-Report.pdf
;;
;; VULNERABILITY: Two ENLIST messages can race; both see empty owner and both
;; can become "owner". Later CLAIM allows only one to withdraw — unfair or loss.
;; =============================================================================
#include "imports/stdlib.fc";

const OP_ENLIST = 1;
const OP_CLAIM = 2;

(int, slice) _load_state() {
  slice ds = get_data().begin_parse();
  int balance = 0;
  slice owner_address = null();

  ;; если состояние не пустое — читаем баланс и адрес
  if (slice_bits(ds) >= 64) {
    balance = ds~load_uint(64);
    owner_address = ds;
  }

  return (balance, owner_address);
}

slice get_msg_sender(cell in_msg) {
  slice cs = in_msg.begin_parse();
  int flags = cs~load_uint(4);
  slice sender_address = cs~load_msg_addr();
  return sender_address;
}

() _save_state(int balance, slice owner_address) impure {
  set_data(begin_cell()
    .store_uint(balance, 64)
    .store_slice(owner_address)
    .end_cell()
  );
}

() recv_internal(int msg_value, cell in_msg, slice in_msg_body) impure {
  var (balance, owner_address) = _load_state();
  slice sender_address = get_msg_sender(in_msg);

  if (slice_bits(in_msg_body) >= 32) {
    int op = in_msg_body~load_uint(32);

    ;; ENLIST: депозит + потенциальный race при назначении owner
    if (op == OP_ENLIST) {
      int amount = in_msg_body~load_uint(128);
      balance += amount;

      ;; CRITICAL RACE CONDITION POINT:
      ;; если два ENLIST приходят "параллельно", оба могут увидеть пустого owner
      if (slice_bits(owner_address) == 0) {
        _save_state(balance, sender_address);
      } else {
        _save_state(balance, owner_address);
      }
      return ();
    }

    ;; CLAIM: вывести все средства, если sender == owner
    if (op == OP_CLAIM) {
      ;; Сравниваем адреса используя встроенный оператор сравнения
      if (equal_slice_bits(owner_address, sender_address)) {
        balance = 0;
        _save_state(balance, null());
      }
      return ();
    }
  }
}

() recv_external(slice _) {
  return ();
}

(int, slice) get_state() method_id {
  return _load_state();
}
