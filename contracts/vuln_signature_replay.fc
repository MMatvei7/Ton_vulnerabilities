;; =============================================================================
;; EXAMPLE 5: MeMeStore PAY-2 — Signature Replay (nonce rollback via bounce)
;; Reference: MeMeStore (TonBit), Contract Examples.docx
;; Audit: https://tonbit.xyz/reports/20240708-MeMeStore-Final-Audit-Report.pdf
;;
;; WithdrawTicket = amount + nonce + signature. PayoutBeacon checks signature,
;; increments nonce, forwards to PayoutsMaster. If PayoutOk bounces back,
;; we (or Master) roll back nonce -> same ticket can be reused (replay).
;;
;; This file: PayoutBeacon — holds nonce, verifies signature, sends request.
;; VULN: recv_bounced decrements nonce when we get bounce from our request;
;; and we accept "RollbackNonce" from PayoutsMaster when Master got bounced
;; PayoutOk. That allows replay of the same signature.
;; =============================================================================
#include "imports/stdlib.fc";

const OP_WITHDRAW_TICKET = 0x7777;
const OP_PAYOUT_OK       = 0x8888;
const OP_ROLLBACK_NONCE  = 0x9999;

(int, slice, int) _load_state() {
  slice ds = get_data().begin_parse();
  int nonce = 0;
  slice master_addr = null();
  int pubkey = 0;
  if (slice_bits(ds) >= 32) {
    nonce = ds~load_uint(32);
    if (slice_bits(ds) >= 2 + 256) {
      master_addr = ds~load_msg_addr();
      if (slice_bits(ds) >= 256) {
        pubkey = ds~load_uint(256);
      }
    }
  }
  return (nonce, master_addr, pubkey);
}

() _save_state(int nonce, slice master_addr, int pubkey) impure {
  set_data(begin_cell()
    .store_uint(nonce, 32)
    .store_slice(master_addr)
    .store_uint(pubkey, 256)
    .end_cell());
}

slice get_sender(cell in_msg) {
  slice cs = in_msg.begin_parse();
  cs~load_uint(4);
  return cs~load_msg_addr();
}

() recv_internal(int msg_value, cell in_msg, slice in_msg_body) impure {
  slice sender = get_sender(in_msg);
  if (slice_bits(in_msg_body) < 32) { return (); }
  int op = in_msg_body~load_uint(32);

  var (nonce, master_addr, pubkey) = _load_state();

  ;; WithdrawTicket: amount (64) || ticket_nonce (32) || signature (512 bits)
  if (op == OP_WITHDRAW_TICKET) {
    if (slice_bits(in_msg_body) < 32 + 64 + 32 + 512) { return (); }
    int amount = in_msg_body~load_uint(64);
    int ticket_nonce = in_msg_body~load_uint(32);
    slice sig = in_msg_body~load_bits(512);
    if (ticket_nonce != nonce) { return (); }
    ;; Verify data = amount || nonce (same encoding as ticket)
    cell data_cell = begin_cell().store_uint(amount, 64).store_uint(nonce, 32).end_cell();
    slice data_slice = data_cell.begin_parse();
    if (check_data_signature(data_slice, sig, pubkey) != -1) { return (); }
    nonce += 1;
    _save_state(nonce, master_addr, pubkey);
    ;; Send request to PayoutsMaster (may bounce if Master has no funds)
    cell msg = begin_cell()
      .store_uint(0x18, 6)
      .store_slice(master_addr)
      .store_coins(msg_value - 50000000)
      .store_uint(0, 1 + 4 + 4 + 64 + 32 + 1 + 1)
      .store_uint(OP_WITHDRAW_TICKET, 32)
      .store_uint(amount, 64)
      .store_slice(sender)
      .end_cell();
    send_raw_message(msg, 64);
    return ();
  }

  ;; PayoutOk from Master — we could accept and do nothing (nonce already incremented)
  if (op == OP_PAYOUT_OK) {
    return ();
  }

  ;; VULNERABILITY: We accept RollbackNonce from Master. When Master receives
  ;; bounced PayoutOk (e.g. we threw when processing it), Master sends us
  ;; RollbackNonce and we decrement nonce. Same ticket becomes valid again.
  if (op == OP_ROLLBACK_NONCE) {
    if (equal_slice_bits(sender, master_addr)) {
      if (nonce > 0) {
        nonce -= 1;
        _save_state(nonce, master_addr, pubkey);
      }
    }
    return ();
  }
}

;; When our request to PayoutsMaster bounces, we could also rollback nonce here.
;; That would allow replay: first attempt bounces (e.g. Master underfunded),
;; we nonce--, user retries same ticket.
() recv_bounced(slice in_msg_body) impure {
  if (slice_bits(in_msg_body) < 64) { return (); }
  in_msg_body~load_uint(32);
  if (slice_bits(in_msg_body) < 32) { return (); }
  int orig_op = in_msg_body~load_uint(32);
  if (orig_op == OP_WITHDRAW_TICKET) {
    var (nonce, master_addr, pubkey) = _load_state();
    if (nonce > 0) {
      _save_state(nonce - 1, master_addr, pubkey);
    }
  }
}

() recv_external(slice _) { return (); }

(int, slice, int) get_state() method_id {
  return _load_state();
}
