;; =============================================================================
;; EXAMPLE 4: MAI1-1 (TonBit) — Delayed ctxSender Check
;; Reference: Torch (TonBit) MAI1-1, Contract Examples.docx
;; Audit: https://tonbit.xyz/reports/20250317-Torch-Final-Audit-Report.pdf
;;
;; VULNERABILITY: In handler the ctxSender (sender) check is done too late.
;; When contract is paused, only allowed senders should act; but we process
;; refund/transfer first and only then check sender. So in paused state
;; an attacker can still trigger refund/transfer before we reject.
;; =============================================================================
#include "imports/stdlib.fc";

const OP_REFUND   = 1;
const OP_TRANSFER = 2;
const OP_SET_PAUSED = 3;

(int, slice, slice) _load_state() {
  slice ds = get_data().begin_parse();
  int paused = 0;
  slice allowed_sender = null();
  slice owner = null();
  if (slice_bits(ds) >= 32) {
    paused = ds~load_uint(32);
    if (slice_bits(ds) >= 2 + 256) {
      allowed_sender = ds~load_msg_addr();
      if (slice_bits(ds) >= 2 + 256) {
        owner = ds~load_msg_addr();
      }
    }
  }
  return (paused, allowed_sender, owner);
}

() _save_state(int paused, slice allowed_sender, slice owner) impure {
  set_data(begin_cell()
    .store_uint(paused, 32)
    .store_slice(allowed_sender)
    .store_slice(owner)
    .end_cell());
}

slice get_sender(cell in_msg) {
  slice cs = in_msg.begin_parse();
  cs~load_uint(4);
  return cs~load_msg_addr();
}

() recv_internal(int msg_value, cell in_msg, slice in_msg_body) impure {
  slice sender = get_sender(in_msg);
  if (slice_bits(in_msg_body) < 32) { return (); }
  int op = in_msg_body~load_uint(32);

  var (paused, allowed_sender, owner) = _load_state();

  ;; VULNERABILITY: we perform refund/transfer BEFORE checking that in paused
  ;; mode only allowed_sender may act. So when paused==1, attacker can still
  ;; get into refund/transfer and receive funds before we throw.
  if (op == OP_REFUND) {
    int amount = in_msg_body~load_coins();
    if (amount > 0) {
      if (msg_value >= amount) {
        cell msg = begin_cell()
          .store_uint(0x18, 6)
          .store_slice(sender)
          .store_coins(amount)
          .store_uint(0, 1 + 4 + 4 + 64 + 32 + 1 + 1)
          .end_cell();
        send_raw_message(msg, 64);
      }
    }
    ;; Check too late: when paused, only allowed_sender should have been able to reach here
    if (paused != 0) {
      throw_unless(401, equal_slice_bits(sender, allowed_sender));
    }
    return ();
  }

  if (op == OP_TRANSFER) {
    slice to = in_msg_body~load_msg_addr();
    int amount = in_msg_body~load_coins();
    if (amount > 0) {
      cell msg = begin_cell()
        .store_uint(0x18, 6)
        .store_slice(to)
        .store_coins(amount)
        .store_uint(0, 1 + 4 + 4 + 64 + 32 + 1 + 1)
        .end_cell();
      send_raw_message(msg, 64);
    }
    if (paused != 0) {
      throw_unless(402, equal_slice_bits(sender, allowed_sender));
    }
    return ();
  }

  if (op == OP_SET_PAUSED) {
    if (equal_slice_bits(sender, owner)) {
      int p = in_msg_body~load_uint(32);
      _save_state(p, allowed_sender, owner);
    }
    return ();
  }
}

() recv_external(slice _) { return (); }

(int, slice, slice) get_state() method_id {
  return _load_state();
}
